<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crazyplay.highwan.party.dao.PartyMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.crazyplay.highwan.party.pojo.Party">
    <result column="id" property="id" />
    <result column="create_time" property="createTime" javaType="java.time.LocalDateTime" />
    <result column="create_user_id" property="createUserId" />
    <result column="update_time" property="updateTime" />
    <result column="update_user_id" property="updateUserId" />
    <result column="is_del" property="isDel" />
        <result column="user_id" property="userId" />
        <result column="area_id" property="areaId" />
        <result column="user_name" property="userName" />
        <result column="title" property="title" />
        <result column="start_time" property="startTime" />
        <result column="end_time" property="endTime" />
        <result column="amount" property="amount" />
        <result column="adress" property="adress" />
    </resultMap>
    
    <resultMap id="partyDetail" type="com.crazyplay.highwan.api.vo.resp.PartyDetailResp">
    <result column="id" property="id" />
    <result column="create_time" property="createTime"/>
    <result column="create_user_id" property="createUserId" />
    <result column="update_time" property="updateTime" />
    <result column="update_user_id" property="updateUserId" />
    <result column="is_del" property="isDel" />
    <result column="user_id" property="userId" />
    <result column="area_id" property="areaId" />
    <result column="user_name" property="userName" />
    <result column="title" property="title" />
    <result column="start_time" property="startTime" />
    <result column="end_time" property="endTime" />
    <result column="amount" property="amount" />
    <result column="adress" property="adress" />
    <result column="content" property="content" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        create_user_id,
        update_time,
        update_user_id,
        is_del,
        user_id, area_id, user_name, title, start_time, end_time, amount, adress
    </sql>
    
    <select id="getPartyById" parameterType="java.lang.String" resultMap="partyDetail">
    	select p.*,pc.content
		from t_party p 
		left join t_party_content pc on p.id = pc.party_id
		where p.id = #{id}
    </select>

    <select id="getRecom" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from t_party
        where is_del = 0
        order by start_time desc
        limit 10
    </select>

</mapper>
